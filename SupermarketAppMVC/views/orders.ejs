<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order History</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
  <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/shopping">Shop</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/categories">Categories</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cart">View Cart</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/reviews">Reviews</a>
          </li>
          <li class="nav-item">
            <a class="nav-link active" href="/orders">Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0">Your Orders</h3>
      <a href="/shopping" class="btn btn-outline-primary btn-sm">Continue Shopping</a>
    </div>
    <% if (orders.length === 0) { %>
      <p class="text-muted">You have no orders yet.</p>
    <% } else { %>
      <div class="row g-3">
        <% orders.forEach(order => { %>
          <div class="col-12">
            <div class="card shadow-sm border-0 h-100">
              <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold">Order <%= order.order_number %></div>
                  <small class="text-muted">Placed: <%= order.placed_at %></small>
                </div>
                <div class="text-end">
                  <div class="text-muted small">Total</div>
                  <div class="fs-5 fw-semibold">$<%= parseFloat(order.total).toFixed(2) %></div>
                </div>
              </div>
              <div class="card-body">
                <div class="list-group list-group-flush">
                  <% (itemsByOrder[order.id] || []).forEach(item => { %>
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                      <div class="d-flex align-items-center gap-3">
                        <% if (item.image) { %>
                          <img src="/images/<%= item.image %>" width="44" height="44" class="rounded border">
                        <% } %>
                        <div>
                          <div class="fw-semibold"><%= item.product_name %></div>
                          <small class="text-muted">Qty: <%= item.quantity %> · $<%= parseFloat(item.price).toFixed(2) %> each</small>
                        </div>
                      </div>
                      <div class="fw-semibold">$<%= (item.price * item.quantity).toFixed(2) %></div>
                    </div>
                  <% }); %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>




