<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Categories</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
  <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/inventory">Inventory</a></li>
          <li class="nav-item"><a class="nav-link" href="/users">View Users</a></li>
          <li class="nav-item"><a class="nav-link active" href="/categories/manage">Manage Categories</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0">Manage Categories</h3>
      <a class="btn btn-outline-secondary btn-sm" href="/categories">View Categories</a>
    </div>

    <% if (errors && errors.length) { %>
      <div class="alert alert-danger">
        <% errors.forEach(e => { %><div><%= e %></div><% }) %>
      </div>
    <% } %>
    <% if (messages && messages.length) { %>
      <div class="alert alert-success">
        <% messages.forEach(m => { %><div><%= m %></div><% }) %>
      </div>
    <% } %>

    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Product</th>
            <th>Current Category</th>
            <th style="width: 360px;">Assign Category</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% products.forEach(p => { %>
            <tr>
              <td class="fw-semibold"><%= p.productName %></td>
              <td><%= p.category || 'Others' %></td>
              <td>
                <form class="row g-2 align-items-center" action="/categories/manage" method="POST">
                  <input type="hidden" name="productId" value="<%= p.id %>">
                  <div class="col-md-5">
                    <select class="form-select form-select-sm" name="categorySelect">
                      <option value="">-- Choose --</option>
                      <% categories.forEach(c => { %>
                        <option value="<%= c %>" <%= p.category === c ? 'selected' : '' %>><%= c %></option>
                      <% }); %>
                    </select>
                  </div>
                  <div class="col-md-5">
                    <input type="text" class="form-control form-control-sm" name="categoryNew" placeholder="Or type new category">
                  </div>
                  <div class="col-md-2">
                    <button class="btn btn-primary btn-sm w-100" type="submit">Save</button>
                  </div>
                </form>
              </td>
              <td></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>




