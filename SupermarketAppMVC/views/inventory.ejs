<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
    <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Supermarket App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/addProduct">Add Product</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/users">View Users</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/categories/manage">Manage Categories</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/categories">Categories</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>

  <div class="container">
    <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
    <br>
    <div class="text-center mb-4"><h2>Products from Supermarket App Database</h2></div>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3">
      <% products.forEach(p => { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0" style="max-width: 220px; margin: 0 auto;">
            <% if (p.image) { %>
              <div class="ratio ratio-4x3 mb-2">
                <img src="images/<%= p.image %>" class="img-fluid w-100 h-100" style="object-fit: contain;" alt="<%= p.productName %>">
              </div>
            <% } %>
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/product/<%= p.id %>" class="h6 text-decoration-none mb-0"><%= p.productName %></a>
                <span class="badge bg-light text-dark">Stock: <%= p.quantity %></span>
              </div>
              <div class="fw-semibold fs-5 mb-3">$<%= p.price.toFixed(2) %></div>
              <div class="mt-auto d-flex gap-2">
                <a class="btn btn-outline-primary btn-sm flex-fill" href="/updateProduct/<%= p.id %>">Edit</a>
                <a class="btn btn-outline-danger btn-sm flex-fill" href="/deleteProduct/<%= p.id %>" onclick="return confirm('Are you sure you want to delete this product?')">Delete</a>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>




