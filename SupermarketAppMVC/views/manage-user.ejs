<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <title>Manage User</title>
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
  <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/inventory">Inventory</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/users">View Users</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/reviews/admin">View Reviews</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/categories">Categories</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <h3 class="mb-0">Manage User</h3>
      <a href="/users" class="btn btn-outline-secondary btn-sm">Back to Users</a>
    </div>
    <% if (errors && errors.length) { %>
      <div class="alert alert-danger">
        <% errors.forEach(e => { %><div><%= e %></div><% }) %>
      </div>
    <% } %>
    <% if (messages && messages.length) { %>
      <div class="alert alert-success">
        <% messages.forEach(m => { %><div><%= m %></div><% }) %>
      </div>
    <% } %>

    <form action="/users/<%= targetUser.id %>/update" method="POST" class="mb-4">
      <div class="row g-3">
        <div class="col-md-6">
          <label class="form-label" for="username">Username</label>
          <input class="form-control" type="text" id="username" name="username" value="<%= targetUser.username %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="email">Email</label>
          <input class="form-control" type="email" id="email" name="email" value="<%= targetUser.email %>" required>
        </div>
        <div class="col-md-6">
          <label class="form-label" for="address">Address</label>
          <input class="form-control" type="text" id="address" name="address" value="<%= targetUser.address %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="contact">Contact</label>
          <input class="form-control" type="text" id="contact" name="contact" value="<%= targetUser.contact %>" required>
        </div>
        <div class="col-md-3">
          <label class="form-label" for="role">Role</label>
          <select class="form-select" id="role" name="role">
            <option value="user" <%= targetUser.role === 'user' ? 'selected' : '' %>>User</option>
            <option value="admin" <%= targetUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
          </select>
        </div>
      </div>
      <div class="d-flex gap-2 mt-3">
        <button class="btn btn-primary" type="submit">Save Changes</button>
        <a class="btn btn-outline-secondary" href="/users">Cancel</a>
      </div>
    </form>

    <form action="/users/<%= targetUser.id %>/delete" method="POST" onsubmit="return confirm('Delete this user?');">
      <button class="btn btn-danger" type="submit">Delete User</button>
    </form>

    <hr class="my-4">
    <div class="d-flex align-items-center mb-3">
      <h4 class="mb-0">Orders</h4>
      <span class="badge bg-secondary ms-2"><%= orders ? orders.length : 0 %></span>
    </div>
    <% if (!orders || orders.length === 0) { %>
      <p class="text-muted">No orders found for this user.</p>
    <% } else { %>
      <div class="row g-3">
        <% orders.forEach(o => { %>
          <div class="col-12">
            <div class="card shadow-sm border-0">
              <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                  <div class="fw-semibold">Order <%= o.order_number || ('#' + o.id) %></div>
                  <small class="text-muted">Placed: <%= o.placed_at %></small>
                </div>
                <div class="text-end">
                  <div class="text-muted small">Total</div>
                  <div class="fs-5 fw-semibold">$<%= Number(o.total).toFixed(2) %></div>
                </div>
              </div>
              <div class="card-body">
                <% if (itemsByOrder && itemsByOrder[o.id] && itemsByOrder[o.id].length) { %>
                  <div class="list-group list-group-flush">
                    <% itemsByOrder[o.id].forEach(it => { %>
                      <div class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                          <div class="fw-semibold"><%= it.product_name %></div>
                          <small class="text-muted">Qty: <%= it.quantity %> · $<%= Number(it.price).toFixed(2) %> each</small>
                        </div>
                        <div class="fw-semibold">$<%= (Number(it.price) * Number(it.quantity)).toFixed(2) %></div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <p class="text-muted mb-0">No items recorded for this order.</p>
                <% } %>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>




