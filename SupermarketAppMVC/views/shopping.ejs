<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
  <script>
  function addToCart(productId) {
    const qty = document.getElementById('qty-' + productId).value;
    const params = new URLSearchParams();
    params.append('quantity', qty);
    params.append('action', 'add');

    fetch('/add-to-cart/' + productId, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: params.toString(),
      credentials: 'include'
    })
    .then(r => {
      if (!r.ok) {
        throw new Error('Server returned ' + r.status);
      }

      // Show toast
      const toastEl = document.getElementById('cartToast');
      const toast = new bootstrap.Toast(toastEl);
      toast.show();
    })
    .catch(err => {
      console.error('Add to cart error:', err);
      alert('Network error');
    });
  }
</script>
</head>
<body>
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Supermarket App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/cart">View Cart</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/orders">Orders</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>

  <div class="container">
    <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
    <br>
    <div class="text-center"><h2>Products from Supermarket</h2></div>
    <br>
    <table class="table table-hover small text-center">
      <thead>
          <tr>
            <th width="100">Product Name</th>
            <th width="100">Product Image</th>
            <th width="50">Stock</th>
            <th width="50">Price</th>
            <th width="100">Quantity</th>
            <th width="150">Action</th>
          </tr>
      </thead>
      <tbody>
        <% for(let i=0; i < products.length; i++) { %>
          <tr>
            <td><a href="/product/<%= products[i].id %>" ><%= products[i].productName %></a></td>
            <td><img src="images/<%= products[i].image %>" width="20%"></td>
            <td><%= products[i].quantity %></td>
            <td>$<%= products[i].price.toFixed(2) %></td>
            <td>
              <select id="qty-<%= products[i].id %>" class="form-control" style="width: 100px; display: inline-block;">
                <% for (let q = 1; q <= 5; q++) { %>
                  <option value="<%= q %>"><%= q %></option>
                <% } %>
              </select>
            </td>
            <td>
  <!-- Buy: JUST go to cart, no add -->
  <a href="/cart" class="btn btn-primary btn-sm">Buy</a>

  <!-- Add to Cart: AJAX, stays on page -->
  <button
    type="button"
    class="btn btn-success btn-sm"
    onclick="addToCart(<%= products[i].id %>)">
    Add to Cart
  </button>
</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1200;">
  <div id="cartToast" class="toast align-items-center text-bg-success border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body">
        Product added to cart!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
