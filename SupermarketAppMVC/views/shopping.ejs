<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <title>Supermarket App</title>
  <script>
  function addToCart(productId) {
    const input = document.getElementById('qty-' + productId);
    const qty = parseInt(input.value, 10);
    const max = parseInt(input.dataset.max, 10) || Infinity;

    if (!qty || qty < 1) {
      alert('Quantity must be at least 1');
      input.value = 1;
      return;
    }
    if (qty > max) {
      alert('Quantity exceeds available stock');
      input.value = max;
      return;
    }

    const params = new URLSearchParams();
    params.append('quantity', qty);
    params.append('action', 'add');

    fetch('/add-to-cart/' + productId, {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: params.toString(),
      credentials: 'include'
    })
    .then(r => {
      if (!r.ok) {
        throw new Error('Server returned ' + r.status);
      }

      // Show toast
      const toastEl = document.getElementById('cartToast');
      const toast = new bootstrap.Toast(toastEl);
      toast.show();
    })
    .catch(err => {
      console.error('Add to cart error:', err);
      alert('Network error');
    });
  }

  function changeQty(productId, delta) {
    const input = document.getElementById('qty-' + productId);
    const max = parseInt(input.dataset.max, 10) || Infinity;
    const current = parseInt(input.value, 10) || 1;
    let next = current + delta;
    if (next < 1) next = 1;
    if (next > max) next = max;
    input.value = next;
  }
</script>
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
    <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Supermarket App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav">
            <li class="nav-item">
              <a class="nav-link" href="/shopping">Shop</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/categories">Categories</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/reviews">Reviews</a>
            </li>
            <li class="nav-item">
              <a class="nav-link" href="/cart">View Cart</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/orders">Orders</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li> 
          </ul>
        </div>
      </div>
    </nav>

  <div class="container">
    <div class="d-flex justify-content-end mb-3">
      <a href="/cart" class="btn btn-primary">Buy</a>
    </div>
    <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
    <br>
    <div class="text-center mb-3"><h3 class="fw-semibold">Products from Supermarket</h3></div>
    <div class="row row-cols-2 row-cols-sm-3 row-cols-lg-5 g-3">
      <% products.forEach(p => { %>
        <div class="col">
          <div class="card h-100 shadow-sm border-0" style="font-size: 0.92rem; max-width: 220px; margin: 0 auto;">
            <% if (p.image) { %>
              <div class="ratio ratio-4x3 mb-2">
                <img src="images/<%= p.image %>" class="img-fluid w-100 h-100" style="object-fit: contain;" alt="<%= p.productName %>">
              </div>
            <% } %>
            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <a href="/product/<%= p.id %>" class="h6 text-decoration-none mb-0"><%= p.productName %></a>
                <span class="badge bg-light text-dark">Stock: <%= p.quantity %></span>
              </div>
              <div class="fw-semibold fs-6 mb-2">$<%= p.price.toFixed(2) %></div>

              <% const maxQty = p.quantity; %>
              <% if (maxQty > 0) { %>
                <div class="input-group input-group-sm mb-2" style="max-width: 160px;">
                  <button class="btn btn-outline-secondary" type="button" onclick="changeQty(<%= p.id %>, -1)">-</button>
                  <input
                    type="number"
                    class="form-control text-center"
                    id="qty-<%= p.id %>"
                    min="1"
                    max="<%= maxQty %>"
                    data-max="<%= maxQty %>"
                    value="1">
                  <button class="btn btn-outline-secondary" type="button" onclick="changeQty(<%= p.id %>, 1)">+</button>
                </div>
              <% } else { %>
                <div class="text-muted mb-2">Out of stock</div>
              <% } %>

              <div class="mt-auto">
                <button
                  type="button"
                  class="btn btn-success w-100 btn-sm"
                  onclick="addToCart(<%= p.id %>)"
                  <%= p.quantity <= 0 ? 'disabled' : '' %>>
                  Add to Cart
                </button>
              </div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  <div class="container mb-4 d-flex justify-content-end">
    <a href="/cart" class="btn btn-primary">Buy</a>
  </div>
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1200;">
  <div id="cartToast" class="toast align-items-center text-bg-success border-0" role="alert">
    <div class="d-flex">
      <div class="toast-body">
        Product added to cart!
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>




