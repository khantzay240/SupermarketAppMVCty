<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Your Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <!-- Navbar -->
  <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item">
            <a class="nav-link" href="/shopping">Shop</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/cart">View Cart</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/orders">Orders</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/checkout">Check Out</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/logout">Logout</a>
          </li> 
        </ul>
      </div>
    </div>
  </nav>
  <!-- Cart Content -->
  <div class="container">
  <h2 class="mt-4">Shopping Cart</h2>
  <% if (cart.length > 0) { %>

    <% let total = 0; %>   <!-- 1. start total at 0 -->

    <table class="table table-bordered">
      <thead>
        <tr>
          <th>Product Name</th>
          <th>Price</th>
          <th>Quantity</th>
          <th>Subtotal</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < cart.length; i++) { %>

          <% total += cart[i].price * cart[i].quantity; %>  <!-- add each subtotal -->

          <tr>
            <td><%= cart[i].productName %></td>
            <td>
              <img src="/images/<%= cart[i].image %>" width="80" class="img-thumbnail">
            </td>
            <td><%= cart[i].quantity %></td>
            <td>$<%= (cart[i].price * cart[i].quantity).toFixed(2) %></td>
            <td>
              <form action="/remove-from-cart/<%= cart[i].id %>" method="POST" style="display: inline;">
  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
</form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>

    <!-- 3. now total definitely exists -->
    <h4>Total: $<%= total.toFixed(2) %></h4>

    <div class="mt-4 d-flex gap-2">
      <a href="/shopping" class="btn btn-secondary">Back to Shopping</a>
      <a href="/checkout" class="btn btn-primary">Check out</a>
    </div>
  <% } else { %>
    <p>Your cart is empty.</p>
  <% } %>
</div>
</body>
</html>
