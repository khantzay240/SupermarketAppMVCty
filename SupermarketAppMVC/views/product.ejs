<!-- product.ejs -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <title>Supermarket App</title>
    <script>
      function changeQty(delta) {
        const input = document.getElementById('qty');
        const max = parseInt(input.dataset.max, 10) || Infinity;
        let next = (parseInt(input.value, 10) || 1) + delta;
        if (next < 1) next = 1;
        if (next > max) next = max;
        input.value = next;
      }
      function validateQty(max) {
        const input = document.getElementById('qty');
        const val = parseInt(input.value, 10);
        if (!val || val < 1) {
          alert('Quantity must be at least 1');
          input.value = 1;
          return false;
        }
        if (val > max) {
          alert('Quantity exceeds available stock');
          input.value = max;
          return false;
        }
        return true;
      }
    </script>
</head>
<body>
    <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
    <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
        <div class="container-fluid">
          <a class="navbar-brand" href="/">Supermarket App</a>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="collapsibleNavbar">
            <ul class="navbar-nav">
              <% if (user.role === "admin") { %>
                <li class="nav-item">
                  <a class="nav-link" href="/inventory">Inventory</a>
                </li> 
                <li class="nav-item">
                  <a class="nav-link" href="/addProduct">Add new product</a>
                </li> 
              <% } %>
              <% if (user.role === "user") { %>
                <li class="nav-item">
                  <a class="nav-link" href="/shopping">Shop</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/categories">Categories</a>
                </li>
                <li class="nav-item">
                  <a class="nav-link" href="/reviews">Reviews</a>
                </li>
              <% } %>
              <li class="nav-item">
                <a class="nav-link" href="/logout">Logout</a>
              </li> 
            </ul>
          </div>
        </div>
    </nav>

    <div class="container">
        <p>Welcome, <%= user.username %> (<%= user.role %>)</p>
        <br>
        <div class="text-center"><h2>Product Details</h2></div>
        <br>
        <% if (product) { %> <!-- Check if product data exists -->
            <div>
                <p><b>Product Name:</b><br> <%= product.productName %></p>
                <p><b>Product Image:</b><br> <img src = "../images/<%= product.image %>" width="20%"></p>
                <p><b>Product Quantity:</b><br> <%= product.quantity %></p>
                <p><b>Price:</b><br> $<%= product.price.toFixed(2) %></p> 

                <% if (product.quantity > 0) { %>
                  <form class="mt-3" method="POST" action="/add-to-cart/<%= product.id %>" onsubmit="return validateQty(<%= product.quantity %>);">
                    <input type="hidden" name="returnTo" value="/product/<%= product.id %>">
                    <input type="hidden" name="fromProduct" value="true">
                    <input type="hidden" name="productName" value="<%= product.productName %>">
                    <input type="hidden" name="price" value="<%= product.price %>">
                    <input type="hidden" name="image" value="<%= product.image %>">
                    <div class="input-group mb-3" style="max-width: 200px;">
                      <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">-</button>
                      <input
                        id="qty"
                        name="quantity"
                        type="number"
                        class="form-control text-center"
                        min="1"
                        max="<%= product.quantity %>"
                        data-max="<%= product.quantity %>"
                        value="1">
                      <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">+</button>
                    </div>
                    <button class="btn btn-success" type="submit">Add to Cart</button>
                  </form>
                <% } else { %>
                  <div class="text-muted">Out of stock</div>
                <% } %>
            </div>
        <% } else { %>
            <p>No product found.</p>
        <% } %>
        <% if (user.role === "admin") { %>
          <a href ="/inventory">Back</a>
        <% } else { %>
          <a href ="/shopping">Back</a>
        <% } %>
    </div>
    
</body>
</html>




