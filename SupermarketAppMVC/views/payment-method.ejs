<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Method</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="text-center py-3" style="background: linear-gradient(90deg, #0f172a, #111827); color: #fff;">
    <div class="d-inline-flex align-items-center gap-3">
      <div style="width:42px;height:42px;border-radius:12px;background:linear-gradient(135deg,#22d3ee,#2563eb);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;">KZN</div>
      <div class="text-start">
        <div style="letter-spacing:2px;font-weight:800;text-transform:uppercase;">KZN supermarket</div>
        <div class="small" style="color:#a5b4fc;">Fresh &middot; Fast &middot; Friendly</div>
      </div>
    </div>
  </div>
  <nav class="navbar navbar-expand-sm navbar-dark" style="background: linear-gradient(90deg, #0f172a, #111827);">
    <div class="container-fluid">
      <a class="navbar-brand" href="/">Supermarket App</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="collapsibleNavbar">
        <ul class="navbar-nav">
          <li class="nav-item"><a class="nav-link" href="/shopping">Shop</a></li>
          <li class="nav-item"><a class="nav-link" href="/cart">View Cart</a></li>
          <li class="nav-item"><a class="nav-link" href="/orders">Orders</a></li>
          <li class="nav-item"><a class="nav-link active" href="/checkout">Checkout</a></li>
          <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
        </ul>
      </div>
    </div>
  </nav>

  <div class="container my-4">
    <div class="row">
      <div class="col-lg-7">
        <div class="card mb-4">
          <div class="card-header bg-light">
            <strong>Order Summary</strong>
          </div>
          <div class="card-body">
            <% if (cart.length > 0) { %>
              <div class="table-responsive">
                <table class="table align-middle">
                  <thead>
                    <tr>
                      <th>Product</th>
                      <th class="text-end">Price</th>
                      <th class="text-center">Qty</th>
                      <th class="text-end">Subtotal</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% cart.forEach(item => { %>
                      <tr>
                        <td><%= item.productName %></td>
                        <td class="text-end">$<%= item.price.toFixed(2) %></td>
                        <td class="text-center"><%= item.quantity %></td>
                        <td class="text-end">$<%= (item.price * item.quantity).toFixed(2) %></td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
              <div class="d-flex justify-content-between align-items-center mt-3">
                <h5 class="mb-0">Total:</h5>
                <h4 class="mb-0">$<%= total.toFixed(2) %></h4>
              </div>
            <% } else { %>
              <p>Your cart is empty. <a href="/shopping">Continue shopping</a>.</p>
            <% } %>
          </div>
        </div>
      </div>
      <div class="col-lg-5">
        <div class="card">
          <div class="card-header bg-primary text-white">
            <strong>Select Payment Method</strong>
          </div>
          <div class="card-body">
            <% if (paypalClientId) { %>
              <p class="mb-3">Pay securely with PayPal.</p>
              <div id="paypal-button-container"></div>
            <% } else { %>
              <div class="alert alert-warning mb-0">PayPal is not configured. Please contact support.</div>
            <% } %>
            <div class="mt-3">
              <a href="/checkout" class="btn btn-outline-secondary btn-sm">Back to Checkout</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <% if (paypalClientId) { %>
  <script src="https://www.paypal.com/sdk/js?client-id=<%= paypalClientId %>&currency=SGD"></script>
  <script>
    const totalAmount = <%= total.toFixed(2) %>;
    paypal.Buttons({
      style: { layout: 'vertical', shape: 'rect', color: 'gold' },
      createOrder: function () {
        return fetch('/api/paypal/create-order', {
          method: 'post',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount: totalAmount })
        })
          .then(res => res.json())
          .then(data => {
            if (data.error) throw new Error(data.error);
            return data.id;
          });
      },
      onApprove: function (data) {
        return fetch('/api/paypal/capture-order', {
          method: 'post',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderID: data.orderID })
        })
          .then(res => res.json())
          .then(result => {
            if (result.redirectUrl) {
              window.location.href = result.redirectUrl;
            } else {
              const detail = result.details?.[0]?.issue || result.details?.[0]?.description;
              const message = result.error || detail || 'Payment not completed.';
              console.error('PayPal capture failed', result);
              alert(message);
            }
          })
          .catch(err => {
            console.error('PayPal capture request failed', err);
            alert('Payment could not be completed. Please try again.');
          });
      },
      onError: function (err) {
        console.error('PayPal error', err);
        alert('Payment could not be completed. Please try again.');
      }
    }).render('#paypal-button-container');
  </script>
  <% } %>
</body>
</html>
